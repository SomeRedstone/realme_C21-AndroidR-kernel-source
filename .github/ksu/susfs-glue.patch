diff --git a/drivers/kernelsu/Kbuild b/drivers/kernelsu/Kbuild
index 6eb4b24..c747a9b 100644
--- a/drivers/kernelsu/Kbuild
+++ b/drivers/kernelsu/Kbuild
@@ -1,5 +1,10 @@
 kernelsu-objs := core/init.o
 
+# Integration pin: KernelSU-Next legacy v3.4.0-legacy (b933b1f728116a456fbebf27b6a8772a640cdf23, upstream commit count 3029).
+# The tree is copied without its .git, so the version identity is set here.
+KSU_VERSION_OVERRIDE ?= 33318
+KSU_VERSION_TAG_OVERRIDE ?= v3.4.0-legacy
+
 kernelsu-objs += compat/kernel_compat.o
 kernelsu-objs += feature/kernel_umount.o
 kernelsu-objs += feature/sulog.o
@@ -256,11 +261,18 @@ $(shell sed -i '/^extern void __init mnt_init/a int path_umount(struct path *pat
 $(info -- KSU_NEXT: adding 'int path_umount(struct path *path, int flags);' to $(srctree)/fs/internal.h)
 endif
 
+# filter_count is only used by disable_seccomp() on kernels >= 5.9 (or with
+# KSU_OPTIONAL_SECCOMP_FILTER_RELEASE). On older kernels it is compiled out,
+# and adding it to struct seccomp changes genksyms CRCs (notably
+# module_layout), which prevents loading vendor modules built against the
+# stock struct layout.
+ifeq ($(shell [ $(VERSION) -gt 5 ] || { [ $(VERSION) -eq 5 ] && [ $(PATCHLEVEL) -ge 9 ]; } && echo yes),yes)
 ifneq ($(shell grep -q "atomic_t filter_count;" $(srctree)/include/linux/seccomp.h; echo $$?),0)
 $(info -- KSU_NEXT: patching struct seccomp for filter_count)
 $(shell sed -i '/int mode;/a\	atomic_t filter_count;' $(srctree)/include/linux/seccomp.h)
 $(shell sed -i '/#include <linux\/thread_info.h>/a\#include <linux/atomic.h>' $(srctree)/include/linux/seccomp.h)
 endif
+endif
 
 # security/selinux backports
 ifneq ($(shell grep -q "selinux_inode(inode)" $(srctree)/security/selinux/hooks.c; echo $$?),0)
